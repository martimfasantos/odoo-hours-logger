# Set DEMO_MODE=true to run the UI with sample data and no real Odoo / Google Calendar.
DEMO_MODE=false

# Google Calendar secret iCal URL (Calendar > Settings > Integrate calendar > "Secret address in iCal format").
GOOGLE_CALENDAR_URL=

# Odoo instance.
ODOO_URL=https://erp.daredata.engineering
ODOO_DB=odoo

# Session-based auth (this Odoo has no API keys). From a logged-in Odoo browser tab,
# DevTools > Application > Cookies, copy:
#   session_id   -> ODOO_SESSION_ID
#   visitor_uuid -> ODOO_VISITOR_UUID  (optional; leave blank if absent)
# NOTE: the session_id EXPIRES periodically (logout / server restart / re-login) — re-copy it when it does.
ODOO_SESSION_ID=
ODOO_VISITOR_UUID=

# Optional overrides — auto-discovered from the session when left blank.
ODOO_USER_ID=
ODOO_NETWORK_MEMBER_ID=

LOCAL_TZ=Europe/Lisbon
# Optional — auto-derived from the Odoo session (get_session_info → username) when blank.
# Set this only to override the session-derived email (e.g. to filter declined calendar events
# under a different address than the one used to log in to Odoo).
USER_EMAIL=
DATA_DIR=data
