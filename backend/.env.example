# Set DEMO_MODE=true to run the UI with sample data and no real Odoo / Google Calendar.
DEMO_MODE=false

# Google Calendar secret iCal URL (Calendar > Settings > Integrate calendar > "Secret address in iCal format").
GOOGLE_CALENDAR_URL=

# Odoo instance.
ODOO_URL=https://erp.daredata.engineering
ODOO_DB=odoo

# Odoo sign-in: your Odoo login (email) and an API key (does not expire).
# Create a key at <ODOO_URL>/web?debug=1 > avatar > My Profile > Account Security > New API Key.
ODOO_USERNAME=
ODOO_API_KEY=

# Optional override — auto-discovered from your Odoo user when left blank.
ODOO_NETWORK_MEMBER_ID=

LOCAL_TZ=Europe/Lisbon
# Optional — defaults to ODOO_USERNAME when blank.
# Set this only to filter declined calendar events under a different address than your Odoo login.
USER_EMAIL=
DATA_DIR=data
